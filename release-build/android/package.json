{
  "name": "shikshaai-granite-lite",
  "productName": "ShikshaAI Granite Lite",
  "private": true,
  "version": "0.1.0",
  "description": "Lightweight offline AI learning powered by IBM Granite 3.3 2B",
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win",
    "mobile:init": "npm run build && cap add android && cap add ios",
    "mobile:copy": "npm run build && cap copy android && cap copy ios",
    "mobile:sync": "npm run mobile:copy"
  },
  "dependencies": {
    "@capacitor/core": "8.4.3",
    "@tensorflow/tfjs": "^4.22.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/cli": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "1.3.0"
  },
  "build": {
    "appId": "org.shikshaai.granitelite",
    "productName": "ShikshaAI Granite Lite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "models",
        "to": "models"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "compression": "store",
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "ShikshaAI-Granite-Lite-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
